{
  "name": "uzhavar-connect",
  "version": "1.0.0",
  "description": "Uzhavar Connect - Agricultural Services Platform",
  "main": "server/index.js",
  "scripts": {
    "build": "npm install && npm install --prefix server && npm install --prefix client && npm run build --prefix client",
    "start": "cross-env NODE_ENV=production PORT=4000 node server/index.js",
    "dev": "npm run build --prefix client && cross-env NODE_ENV=production PORT=4000 node server/index.js",
    "dev:split": "concurrently \"npm start --prefix server\" \"npm start --prefix client\"",
    "prod": "cross-env NODE_ENV=production PORT=4000 node server/index.js"
  },
  "engines": {
    "node": ">=18.0.0 <25.0.0"
  },
  "dependencies": {
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3"
  },
  "keywords": [],
  "author": "Uzhavar Team",
  "license": "ISC"
}
